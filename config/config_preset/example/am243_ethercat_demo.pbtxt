general {
  operation_mode: MODE_TEST
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "am243_ethercat_demo"
  id: 243
}

robot {
  # The AM243 is one EtherCAT slave under the NIC's shared SOEM master;
  # the actuator binds through (board_name, channel). PDO offsets and sizes
  # are omitted so the board resolves the region from slave discovery.
  boards {
    name: "am243_1"
    board_type: AM243
    comm {
      comm_type: ETHERCAT
      transport_type: CYCLIC
      ethercat_config {
        interface_name: "ethercat0"
        process_data_mode: ETHERCAT_PROCESS_DATA_MODE_SPLIT_LRD_LWR
      }
    }
    channels { index: 0 drive: PDO_JOINT }
    am243_config {
      slave_index: 1
      pdo_mapping: AM243_PDO_MAPPING_TI_DEMO
    }
  }
  actions {
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "am243_joint_1/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "am243_joint_1"
        id: 1
        motor_type: MOTOR_TI_DEMO
        board_name: "am243_1"
        channel: 0
        physical_lower_limit: -180
        physical_upper_limit: 180
        operational_lower_limit: -90
        operational_upper_limit: 90
        am243_ethercat_config { idle_position: 0 }
      }
    }
  }
}
