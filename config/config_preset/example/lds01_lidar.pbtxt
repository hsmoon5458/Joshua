general{
    operation_mode: MODE_TEST
    robot_type: ROBOT_TYPE_MANIPULATOR_ARM
    name: "lds01_lidar_test"
    id: 1
  }

  robot {
    perceptions {
      single_perceptions {
        node {
          id: 1
          node_type: LIDAR_PUBLISHER
          qos_setting {}
          publishers {
            ros2_data_type: POINTCLOUD2
            topic: "lds01_lidar_1"
            publish_rate_hz: 3
          }
        }
        sensor {
          sensor_name: "lds01_lidar_1"
          id: 1
          sensor_type: RANGE_SCAN
          comm {
            comm_type: SERIAL
            transport_type: BYTE_STREAM
            serial_config {
              id: 1
              port: "/dev/ttyUSB0"
              baudrate: 230400
            }
          }
          lds01_config {}
        }
      }
    }
  }
