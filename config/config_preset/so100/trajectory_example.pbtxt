# Playback a simple joint trajectory on SO-100 via trajectory_publisher + actuator_subscriber.
#
# Launch:
#   bazel run //launcher:joshua_main -- \
#     --config=config/config_preset/so100/trajectory_example.pbtxt
#
# Topics use Float32 on /<device_id>/position. Positions are raw
# servo ticks: first all joints to span midpoint, then coordinated poses inside
# the ±10% band (20% of operational span), with all motors moving together.

general {
  operation_mode: MODE_TEST
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "so100"
  id: 1
}

robot {
  boards {
    name: "arm_bus"
    board_type: FEETECH_BUS
    comm {
      comm_type: SERIAL
      transport_type: MESSAGE
      serial_config { port: "/dev/ttyACM0" baudrate: 1000000 }
    }
    channels { index: 1 drive: SERVO_BUS_UART signal: SERVO_BUS_REGISTER servo_bus { servo_id: 1 } }
    channels { index: 2 drive: SERVO_BUS_UART signal: SERVO_BUS_REGISTER servo_bus { servo_id: 2 } }
    channels { index: 3 drive: SERVO_BUS_UART signal: SERVO_BUS_REGISTER servo_bus { servo_id: 3 } }
    channels { index: 4 drive: SERVO_BUS_UART signal: SERVO_BUS_REGISTER servo_bus { servo_id: 4 } }
    channels { index: 5 drive: SERVO_BUS_UART signal: SERVO_BUS_REGISTER servo_bus { servo_id: 5 } }
    channels { index: 6 drive: SERVO_BUS_UART signal: SERVO_BUS_REGISTER servo_bus { servo_id: 6 } }
  }
  actions {
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "sts_motor_1/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_1"
        id: 1
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 1
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 973
        operational_upper_limit: 3034
        sts3215_config {
          servo_id: 1
          move_speed: 1000
          idle_position: 2070
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "sts_motor_2/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_2"
        id: 2
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 2
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 858
        operational_upper_limit: 3154
        sts3215_config {
          servo_id: 2
          move_speed: 1000
          idle_position: 847
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "sts_motor_3/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_3"
        id: 3
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 3
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 798
        operational_upper_limit: 3015
        sts3215_config {
          servo_id: 3
          move_speed: 1000
          idle_position: 3011
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "sts_motor_4/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_4"
        id: 4
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 4
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 668
        operational_upper_limit: 3124
        sts3215_config {
          servo_id: 4
          move_speed: 1000
          idle_position: 655
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "sts_motor_5/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_5"
        id: 5
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 5
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 902
        operational_upper_limit: 2955
        sts3215_config {
          servo_id: 5
          move_speed: 1000
          idle_position: 1838
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "sts_motor_6/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_6"
        id: 6
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 6
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 1795
        operational_upper_limit: 3235
        sts3215_config {
          servo_id: 6
          move_speed: 1000
          idle_position: 1806
        }
      }
    }
  }

  trajectories {
    single_trajectories {
      node {
        id: 2
        node_type: TRAJECTORY_PUBLISHER
        qos_setting { depth: 10 }
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts_motor_1/position"
        }
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts_motor_2/position"
        }
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts_motor_3/position"
        }
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts_motor_4/position"
        }
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts_motor_5/position"
        }
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts_motor_6/position"
        }
      }
      trajectory {
        # Midpoint of each joint's operational span (raw ticks).
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_1/position" action { position: 2004.0 } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_2/position" action { position: 2006.0 } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_3/position" action { position: 1907.0 } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_4/position" action { position: 1896.0 } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_5/position" action { position: 1929.0 } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_6/position" action { position: 2515.0 } }

        # Pose A: all joints move together within ±10% band (20% total span).
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_1/position" action { position: 2210.0 } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_2/position" action { position: 1776.0 } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_3/position" action { position: 2128.0 } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_4/position" action { position: 1650.0 } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_5/position" action { position: 2134.0 } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_6/position" action { position: 2371.0 } }

        # Pose B: simultaneous opposite corners in band.
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_1/position" action { position: 1797.0 } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_2/position" action { position: 2236.0 } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_3/position" action { position: 1685.0 } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_4/position" action { position: 2142.0 } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_5/position" action { position: 1723.0 } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_6/position" action { position: 2659.0 } }

        # Pose C: mixed offsets, all joints at once.
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_1/position" action { position: 2100.0 } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_2/position" action { position: 1850.0 } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_3/position" action { position: 2050.0 } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_4/position" action { position: 1800.0 } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_5/position" action { position: 2080.0 } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_6/position" action { position: 2450.0 } }

        # Return to midpoint together.
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_1/position" action { position: 2004.0 } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_2/position" action { position: 2006.0 } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_3/position" action { position: 1907.0 } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_4/position" action { position: 1896.0 } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_5/position" action { position: 1929.0 } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_6/position" action { position: 2515.0 } }
      }
    }
  }
}
